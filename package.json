{
  "name": "node-snet",
  "version": "2.0.0",
  "description": "Simple Network: reliable UDP with priorities and a RakNet-style BitStream, wire compatible with Lua SNET",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "bash scripts/setup-lua.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/lowercase-changelogs.mjs",
    "changelog:check": "node scripts/lowercase-changelogs.mjs --check",
    "release:all": "node scripts/release.mjs",
    "publish:npm": "node scripts/publish.mjs",
    "release:notes": "node scripts/auto-release.mjs",
    "release:trust": "node scripts/trust.mjs"
  },
  "homepage": "https://github.com/neverlane/node-snet",
  "repository": {
    "type": "git",
    "url": "https://github.com/neverlane/node-snet.git"
  },
  "keywords": [
    "snet",
    "slnet",
    "network",
    "simple",
    "modern",
    "promise",
    "typescript",
    "udp",
    "bitstream",
    "raknet",
    "reliable",
    "lua"
  ],
  "author": "neverlane",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.22.0",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^18.19.43",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^5.1.1"
  }
}
